# OKX API 凭证
# 权限只勾「读取 + 交易」，切勿开启提币
# 必须绑定 IP 白名单：带交易权限但不绑 IP 的 Key 会在 14 天后自动失效
# 不知道填什么 IP？启动后在向导第一步会直接显示，点一下就能复制
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# 站点域名（全球站）
OKX_BASE_URL=https://www.okx.com

# 网络通道
#   auto   先走内置直连通道，不通再走下面的代理（推荐，不用改）
#   direct 只用直连，完全不依赖代理软件
#   proxy  只用代理
# 内置直连通道会自己绕开国内对 okx.com 的 DNS 污染和 SNI 阻断，
# 所以大多数情况下 OKX_PROXY 留空即可，不需要装 Clash。
OKX_NETWORK=auto

# 代理地址，留空表示不用代理
# 「自动」模式下它只是兜底：直连失败才会用到
OKX_PROXY=

# 1 = 模拟盘，0 = 实盘
OKX_SIMULATED=1

# AI Builder Program 归因码（1-16 位字母数字）
# 配置后每张下单请求都会带上 tag 字段
# 获取地址：https://www.okx.com/zh-hans/agent-tradekit/builder
OKX_BUILDER_CODE=

# 首次配置向导是否已完成（1 = 已完成，之后启动直接进控制台）
OKX_SETUP_DONE=
